-- v4 -> v5: persistent credential commit gate (one logical row per connection).
--
-- Structure must stay identical to the fresh CREATE in CredentialGate.sq; the migration test
-- compares a migrated database with a fresh one.
CREATE TABLE credential_gate (
    connection_id TEXT NOT NULL PRIMARY KEY,
    operation_id TEXT NOT NULL,
    account_id TEXT NOT NULL,
    state TEXT NOT NULL,
    updated_at_ms INTEGER NOT NULL
);
