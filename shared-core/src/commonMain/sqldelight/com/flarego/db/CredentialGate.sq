CREATE TABLE credential_gate (
    connection_id TEXT NOT NULL PRIMARY KEY,
    operation_id TEXT NOT NULL,
    account_id TEXT NOT NULL,
    state TEXT NOT NULL,
    updated_at_ms INTEGER NOT NULL
);

-- One logical gate per connection: the newest attempt replaces the row inside one transaction,
-- so an observer can never see a "no gate" window during replacement.
gateForConnection:
SELECT operation_id, connection_id, account_id, state FROM credential_gate
WHERE connection_id = ?;

deleteConnectionGate:
DELETE FROM credential_gate WHERE connection_id = ?;

insertGate:
INSERT INTO credential_gate(connection_id, operation_id, account_id, state, updated_at_ms)
VALUES (?, ?, ?, 'PENDING', ?);

-- Only the owning operation can release or block it.
releaseGate:
DELETE FROM credential_gate WHERE connection_id = ? AND operation_id = ?;

blockGate:
UPDATE credential_gate SET state = 'BLOCKED', updated_at_ms = ?
WHERE connection_id = ? AND operation_id = ?;

removeConnectionGates:
DELETE FROM credential_gate WHERE connection_id = ?;
