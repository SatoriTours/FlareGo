-- v2 -> v3: safe bounded batch evidence. Matches fresh schema.
-- Bounded safe metadata only; never an executable DNS request.
CREATE TABLE dns_batch_evidence (
    task_id TEXT NOT NULL PRIMARY KEY,
    version INTEGER NOT NULL,
    connection_id TEXT NOT NULL,
    account_id TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    delete_count INTEGER NOT NULL,
    patch_count INTEGER NOT NULL,
    put_count INTEGER NOT NULL,
    post_count INTEGER NOT NULL,
    manifest_hash TEXT NOT NULL,
    transaction_receipt TEXT NOT NULL
);
CREATE TABLE dns_batch_item (
    task_id TEXT NOT NULL,
    ordinal INTEGER NOT NULL,
    kind TEXT NOT NULL,
    item_index INTEGER NOT NULL,
    record_id TEXT,
    create_type TEXT,
    create_name TEXT,
    desired_hash TEXT NOT NULL,
    before_hash TEXT,
    provider_id TEXT,
    creation_precondition_version INTEGER,
    PRIMARY KEY(task_id, ordinal)
);
-- Covers both operationStore and legacy LocalStore connection removal.
-- Writers explicitly preserve evidence around task INSERT OR REPLACE.
CREATE TRIGGER dns_batch_parent_removed AFTER DELETE ON task BEGIN
    DELETE FROM dns_batch_item WHERE task_id NOT IN (SELECT id FROM task);
    DELETE FROM dns_batch_evidence WHERE task_id NOT IN (SELECT id FROM task);
END;
